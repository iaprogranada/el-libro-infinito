# Copia este archivo como .env.local para desarrollo, o pon estas variables en Vercel
# (Project → Settings → Environment Variables). Nunca subas las claves reales a GitHub.

# Dirección pública de la web, sin barra final
NEXT_PUBLIC_SITE_URL=https://ellibroinfinito.com

# Supabase (Project Settings → API)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic (console.anthropic.com → API Keys): filtro y resumen
ANTHROPIC_API_KEY=

# Stripe (dashboard.stripe.com → Developers)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# PayPal (developer.paypal.com → Apps & Credentials). PAYPAL_ENV: sandbox o live
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox

# Sal para anonimizar IPs en el límite de envíos (cualquier texto largo y aleatorio)
RATE_LIMIT_SALT=   # opcional
